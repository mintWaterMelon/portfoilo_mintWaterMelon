# 1. npm install 시 생성되는 거대한 라이브러리 폴더 (가장 중요 ⭐)
node_modules/

# 2. npm run dev 또는 빌드 시 생성되는 빌드 결과물 및 캐시 폴더
.next/
.nuxt/
dist/
build/
.svelte-kit/
.turbo/

# 3. 개발 중 발생하는 에러/로그 파일
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. 로컬 환경 변수 파일 (보안을 위해 깃허브에 올라가면 안 됨)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 5. 운영체제에서 생성하는 시스템 파일
.DS_Store
Thumbs.db